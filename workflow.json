{
  "name": "Smart Garden com IA",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Configuração Smart Garden",
        "formDescription": "Informe sua localização e uma dúvida sobre irrigação do seu jardim.",
        "formFields": {
          "values": [
            { "fieldLabel": "latitude",  "fieldType": "number", "requiredField": true },
            { "fieldLabel": "longitude", "fieldType": "number", "requiredField": true },
            { "fieldLabel": "pergunta",  "fieldType": "text",   "requiredField": true, "placeholder": "Ex: Devo irrigar agora? Quanto tempo de irrigação?" }
          ]
        },
        "options": {}
      },
      "id": "node-form-trigger",
      "name": "Configuração Smart Garden",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [240, 60],
      "webhookId": "smart-garden-webhook-002"
    },

    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.latitude }}&longitude={{ $json.longitude }}&hourly=precipitation_probability&forecast_days=1",
        "options": {}
      },
      "id": "node-http-weather",
      "name": "Obter Previsão do Tempo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 200]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-rain",
              "name": "rain_probability",
              "value": "={{ $json.hourly.precipitation_probability[0] }}",
              "type": "number"
            },
            {
              "id": "assign-lat",
              "name": "latitude",
              "value": "={{ $('Configuração Smart Garden').item.json.latitude }}",
              "type": "number"
            },
            {
              "id": "assign-lon",
              "name": "longitude",
              "value": "={{ $('Configuração Smart Garden').item.json.longitude }}",
              "type": "number"
            },
            {
              "id": "assign-pergunta",
              "name": "pergunta",
              "value": "={{ $('Configuração Smart Garden').item.json.pergunta }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-rain",
      "name": "Salvar Chuva",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 340]
    },

    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.latitude }}&longitude={{ $json.longitude }}&hourly=soil_moisture_0_to_1cm&forecast_days=1",
        "options": {}
      },
      "id": "node-http-soil",
      "name": "Umidade do Solo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 480]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-soil",
              "name": "soil_moisture_m3",
              "value": "={{ $json.hourly.soil_moisture_0_to_1cm[0] }}",
              "type": "number"
            },
            {
              "id": "assign-rain2",
              "name": "rain_probability",
              "value": "={{ $('Salvar Chuva').item.json.rain_probability }}",
              "type": "number"
            },
            {
              "id": "assign-lat2",
              "name": "latitude",
              "value": "={{ $('Salvar Chuva').item.json.latitude }}",
              "type": "number"
            },
            {
              "id": "assign-lon2",
              "name": "longitude",
              "value": "={{ $('Salvar Chuva').item.json.longitude }}",
              "type": "number"
            },
            {
              "id": "assign-pergunta2",
              "name": "pergunta",
              "value": "={{ $('Salvar Chuva').item.json.pergunta }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-soil",
      "name": "Salvar Solo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 620]
    },

    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.bigdatacloud.net/data/reverse-geocode-client?latitude={{ $json.latitude }}&longitude={{ $json.longitude }}&localityLanguage=pt",
        "options": {}
      },
      "id": "node-http-location",
      "name": "Nome da Região",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 760]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-region",
              "name": "region_name",
              "value": "={{ $json.city + ', ' + $json.principalSubdivision + ' - ' + $json.countryName }}",
              "type": "string"
            },
            {
              "id": "assign-soil2",
              "name": "soil_moisture_m3",
              "value": "={{ $('Salvar Solo').item.json.soil_moisture_m3 }}",
              "type": "number"
            },
            {
              "id": "assign-rain3",
              "name": "rain_probability",
              "value": "={{ $('Salvar Solo').item.json.rain_probability }}",
              "type": "number"
            },
            {
              "id": "assign-lat3",
              "name": "latitude",
              "value": "={{ $('Salvar Solo').item.json.latitude }}",
              "type": "number"
            },
            {
              "id": "assign-lon3",
              "name": "longitude",
              "value": "={{ $('Salvar Solo').item.json.longitude }}",
              "type": "number"
            },
            {
              "id": "assign-pergunta3",
              "name": "pergunta",
              "value": "={{ $('Salvar Solo').item.json.pergunta }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-dados",
      "name": "Consolidar Dados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 900]
    },

    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gemini-2.0-flash-lite-preview",
          "mode": "list",
          "cachedResultName": "gemini-2.0-flash-lite-preview"
        },
        "options": {},
        "messages": {
          "messageValues": [
            {
              "role": "model",
              "content": "Você é um assistente de jardinagem e irrigação inteligente. Seu papel é analisar dados meteorológicos e de umidade do solo para orientar o jardineiro sobre quando e como irrigar. Responda de forma prática e direta, sempre em português."
            },
            {
              "role": "user",
              "content": "={{ 'Dados coletados para a região: ' + $json.region_name + '\\n' + 'Coordenadas: ' + $json.latitude + ', ' + $json.longitude + '\\n' + 'Chance de chuva na próxima hora: ' + $json.rain_probability + '%\\n' + 'Umidade atual do solo (0-1cm): ' + $json.soil_moisture_m3 + ' m³/m³ (referência: seco < 0.20 | ideal 0.20–0.35 | úmido > 0.35)\\n\\n' + 'Usuário pergunta: ' + $('Configuração Smart Garden').item.json.pergunta }}"
            }
          ]
        }
      },
      "id": "node-llm-gemini",
      "name": "Analisar com IA (Gemini)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [240, 1040]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-resposta",
              "name": "resposta_ia",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "assign-regiao-final",
              "name": "region_name",
              "value": "={{ $('Consolidar Dados').item.json.region_name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-resposta",
      "name": "Extrair Resposta da IA",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 1180]
    },

    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Recomendação do seu Assistente de Jardim 🌱",
        "completionMessage": "={{ '📍 Região: ' + $json.region_name + '\\n\\n🤖 ' + $json.resposta_ia }}",
        "options": {}
      },
      "id": "node-form-end",
      "name": "Exibir Resposta",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.2,
      "position": [240, 1320]
    }
  ],

